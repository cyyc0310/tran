{
  "experiment": "InTaSet M1<->M2 controlled Neural ODE and additive four-tank hybrid baselines",
  "source_archive": {
    "path": "algorithmic-control-v1/source/InTaSet.zip",
    "zenodo_md5": "0fe80940a3c9520e665b769f4b8d5ab8",
    "sha256": "a0aac3b0985bec232afa8f9e95cd87612515904f5e574bc483777e4d532e8c85",
