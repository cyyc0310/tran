    "batches_per_epoch": 4,
    "optimizer": "Adam, learning rate 1e-3, weight decay 1e-5, gradient norm clipped at 5.",
    "hybrid_correlation_regularizer_weight": 0.01,
    "selection_rule": "Minimum equal-weight normalized 0.5/1-second free-rollout RMSE on the source chronological validation tail; candidates with any diverged horizon are ineligible.",
